<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Self-update permission for sideload distribution only -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- AccessibilityService for volume key combo detection (sideload only;
             Play Store rejects BIND_ACCESSIBILITY_SERVICE for non-accessibility tools) -->
        <service
            android:name=".VolumeKeyService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_key_service_config" />
        </service>
    </application>
</manifest>
